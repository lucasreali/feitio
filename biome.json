{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["**", "!apps/api/drizzle"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 4
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		},
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["apps/api/**"],
			"linter": {
				"rules": {
					"style": {
						"useImportType": "off"
					}
				}
			}
		},
		{
			"includes": [
				"apps/admin/**",
				"apps/checkout/**",
				"packages/storefront-starter/**"
			],
			"linter": {
				"domains": {
					"react": "recommended"
				},
				"rules": {
					"nursery": {
						"useSortedClasses": {
							"level": "warn",
							"fix": "safe",
							"options": {
								"attributes": ["className"],
								"functions": ["clsx", "cn", "cva"]
							}
						}
					}
				}
			}
		}
	]
}
