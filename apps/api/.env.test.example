# The API e2e suite's environment: copy to .env.test. Test values only, for the
# disposable services in docker-compose.test.yml (`pnpm --filter api test:e2e:setup`).
# vitest.config.e2e.ts reads this file and never .env, and refuses to run when the
# database, storage or Valkey are not local (see scripts/test-env.ts).
DATABASE_URL=postgresql://feitio_app:feitio-app-test-password@localhost:5433/feitio
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/feitio

STORAGE_ENDPOINT=http://localhost:9100
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_BUCKET=feitio-public
STORAGE_PRIVATE_BUCKET=feitio-private
STORAGE_ACCESS_KEY_ID=feitio-test
STORAGE_SECRET_ACCESS_KEY=feitio-test-secret
STORAGE_PUBLIC_URL=http://localhost:9100/feitio-public

VALKEY_URL=redis://localhost:6380

COOKIE_SECRET=feitio-test-cookie-secret-not-used-anywhere-else

# The e2e tests replace Melhor Envio and Asaas with fakes; nothing reaches them.
MELHOR_ENVIO_URL=https://sandbox.melhorenvio.com.br
MELHOR_ENVIO_TOKEN=feitio-test-token
MELHOR_ENVIO_USER_AGENT=Feitio tests (tests@example.com)
ASAAS_URL=https://api-sandbox.asaas.com
ASAAS_API_KEY=feitio-test-key
ASAAS_WALLET_ID=feitio-test-wallet
PAYMENT_FEE_PERCENT=0
PAYMENT_SECRET_KEY=ZmVpdGlvLWNpLXBheW1lbnQtc2VjcmV0LWtleS0zMmI=
PUBLIC_API_URL=http://localhost:3000
