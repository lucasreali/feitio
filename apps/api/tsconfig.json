{
	"extends": "@feitio/config/tsconfig.node.json",
	"compilerOptions": {
		"declaration": true,
		"removeComments": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"strictPropertyInitialization": false,
		"sourceMap": true,
		"outDir": "./dist",
		"rootDir": ".",
		"incremental": true,
		// scripts/ run straight from .ts with Node, so they import each other as .ts.
		"rewriteRelativeImportExtensions": true,
		"paths": {
			"@/*": ["./src/*"]
		},
		"types": ["vitest/globals", "node"]
	}
}
