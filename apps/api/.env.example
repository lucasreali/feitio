PORT=3000

# PostgreSQL: Supabase session pooler (port 5432, never the 6543 transaction pooler).
# TLS is validated with the Supabase CA saved in apps/api/certs/ (see README).
# Two users: the API connects as the application user (feitio_app), which does not
# own the tables and cannot bypass row-level security; migrations, `db:roles` and
# `db:seed` connect as the owner of the tables. `db:roles` creates the application
# user with the name and password given in DATABASE_URL.
DATABASE_URL=postgresql://feitio_app.<project-ref>:<app-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=certs/prod-ca-2021.crt
MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=certs/prod-ca-2021.crt

# S3-compatible file storage: Supabase Storage (keys from Storage > S3 Configuration).
STORAGE_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
STORAGE_REGION=<region>
STORAGE_PUBLIC_BUCKET=feitio-public
STORAGE_PRIVATE_BUCKET=feitio-private
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Base address of the public bucket's files.
STORAGE_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public/feitio-public

# Valkey (in-memory store) from docker-compose.yml locally. redis:// is the protocol scheme Valkey speaks.
VALKEY_URL=redis://localhost:6379

# Signs cookies. Required, at least 32 characters; generate one with: openssl rand -base64 48
COOKIE_SECRET=
# Admin panel sessions, stored in Valkey. Name and lifetime (seconds without use) of the session cookie.
SESSION_COOKIE_NAME=feitio_session
SESSION_TTL_SECONDS=604800
# Optional cookie domain (e.g. .feitio.com.br). Leave empty for the API host only.
SESSION_COOKIE_DOMAIN=
