PORT=3000

# Used by docker-compose.yml to create the development database.
POSTGRES_USER=feitio
POSTGRES_PASSWORD=feitio
POSTGRES_DB=feitio
POSTGRES_PORT=5432

DATABASE_URL=postgres://feitio:feitio@localhost:5432/feitio

# S3-compatible file storage. Locally served by the storage service in docker-compose.yml.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_BUCKET=feitio-public
STORAGE_PRIVATE_BUCKET=feitio-private
STORAGE_ACCESS_KEY_ID=feitio
STORAGE_SECRET_ACCESS_KEY=feitio-dev-secret
# Base address of the public bucket's files.
STORAGE_PUBLIC_URL=http://localhost:9000/feitio-public
