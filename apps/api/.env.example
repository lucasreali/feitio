PORT=3000

# PostgreSQL: Supabase session pooler (port 5432, never the 6543 transaction pooler).
# TLS is validated with the Supabase CA saved in apps/api/certs/ (see README).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=certs/prod-ca-2021.crt

# S3-compatible file storage: Supabase Storage (keys from Storage > S3 Configuration).
STORAGE_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
STORAGE_REGION=<region>
STORAGE_PUBLIC_BUCKET=feitio-public
STORAGE_PRIVATE_BUCKET=feitio-private
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Base address of the public bucket's files.
STORAGE_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public/feitio-public

# Redis protocol: Valkey from docker-compose.yml locally.
REDIS_URL=redis://localhost:6379
